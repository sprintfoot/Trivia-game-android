    "flag-icons": "^7.6.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
